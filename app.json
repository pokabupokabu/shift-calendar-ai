{
  "expo": {
    "name": "ShifToKare",
    "slug": "shift-calendar-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shiftcalendarai",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.pokabu.shiftcalendarai",
      "infoPlist": {
        "CFBundleDisplayName": "シフToカレ",
        "NSCameraUsageDescription": "シフト表をその場で撮影して読み取るためにカメラを使用します。撮影した写真はシフトの解析にのみ利用します。",
        "NSPhotoLibraryUsageDescription": "保存済みのシフト表の写真を選んで読み取るために写真へのアクセスを使用します。選んだ写真はシフトの解析にのみ利用します。",
        "NSCalendarsUsageDescription": "読み取ったあなたのシフトをカレンダーの予定として登録するために使用します。同じ時間帯に既存の予定がないかを確認するため、予定の読み取りも行います。",
        "NSCalendarsFullAccessUsageDescription": "読み取ったあなたのシフトをカレンダーの予定として登録するために使用します。同じ時間帯に既存の予定がないかを確認するため、予定の読み取りも行います。"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [

# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time.
# Anything placed here is readable by anyone who unpacks the app binary -
# never put a secret that grants write access or costs money per call here.
# See src/config/env.ts and README.md "AIプロバイダAPIキーの扱いについて" for details.

# --- AI provider ---
# Requests go through the shiftokare-ai-proxy Cloudflare Worker (server/ai-proxy/)
# instead of calling Anthropic directly - the real Anthropic API key lives only in that
# Worker's secrets, never in this client bundle. See server/ai-proxy/README.md to deploy
# it; EXPO_PUBLIC_AI_PROXY_SECRET must match that Worker's APP_SHARED_SECRET.
EXPO_PUBLIC_AI_PROXY_URL=
EXPO_PUBLIC_AI_PROXY_SECRET=
# Anthropic models: standard scans (free and PRO) and PRO's separate-quota "advanced scan".
# Unset = the defaults in src/config/env.ts. If you change them, also update
# ANTHROPIC_ALLOWED_MODELS in server/ai-proxy/src/index.ts and redeploy (else 404).
EXPO_PUBLIC_AI_MODEL_STANDARD=
EXPO_PUBLIC_AI_MODEL_ADVANCED=

# --- Google Calendar (OAuth client is public by design, no secret here) ---
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# --- PRO subscription (RevenueCat, iOS/App Store) ---
# Public API key from the RevenueCat dashboard (not a secret, same as any App Store
# client key). The "pro" entitlement must be configured there to match
# src/constants/purchases.ts. Native-only (no web implementation); unset = purchases
# disabled, PRO stays togglable via the dev promo code in 設定 > アカウント設定.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=

# --- Development only ---
# Shows the DEVPRO / DEVFREE promo codes in 設定 > アカウント設定, which flip the PRO flag
# without paying. NEVER set this for an App Store build - leaving it unset disables the UI.
EXPO_PUBLIC_ENABLE_DEV_PROMO=true

# Expo inlines any EXPO_PUBLIC_* variable into the JS bundle at build time.
# Anything placed here is readable by anyone who unpacks the app binary -
# never put a secret that grants write access or costs money per call here.
# See src/config/env.ts and README.md "AIプロバイダAPIキーの扱いについて" for details.

# --- AI provider ---
# Requests go through the gemini-shift-proxy Cloudflare Worker (server/gemini-proxy/)
# instead of calling Gemini directly - the real Gemini API key lives only in that
# Worker's secrets, never in this client bundle. See server/gemini-proxy/README.md
# to deploy it; EXPO_PUBLIC_AI_PROXY_SECRET must match that Worker's APP_SHARED_SECRET.
EXPO_PUBLIC_AI_PROVIDER=gemini
EXPO_PUBLIC_AI_PROXY_URL=
EXPO_PUBLIC_AI_PROXY_SECRET=
# Gemini model names change frequently (Gemini 2.5 Flash is EOL 2026-10-16) -
# check https://ai.google.dev/gemini-api/docs/models for the current id.
EXPO_PUBLIC_GEMINI_MODEL=gemini-3-flash-preview

# --- Google Calendar (OAuth client is public by design, no secret here) ---
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
